      "type": "object"
    },
    "CriterionResult": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Criterion Id",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "number"
            },
            {
              "const": "N/A",
              "type": "string"
            }
          ],
          "title": "Value"
        },
        "reasoning": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reasoning",
          "type": "string"
        },
        "evidence_message_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Message Ids",
          "type": "array"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        }
      },
      "required": [
        "criterion_id",
        "value",
        "reasoning",
        "evidence_message_ids"
      ],
      "title": "CriterionResult",
      "type": "object"
    },
    "CriterionScore": {
      "additionalProperties": false,
