# Create once with: python -m scripts.init_env (never overwrites .env).
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP_1=
GEMINI_API_KEY_BACKUP_2=
# Equal group labels mean a shared Gemini project/quota. Blank means unknown, not independent.
GEMINI_QUOTA_GROUP=
GEMINI_BACKUP_1_QUOTA_GROUP=
GEMINI_BACKUP_2_QUOTA_GROUP=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_PROVIDER=gemini
DEV_API_URL=
# Optional exact HTTPS endpoint for shared demo imports. Defaults to the endpoint of DEV_API_URL.
# Only host + path are used; the visitor must paste the full signed link in the import form.
CQA_DEMO_ORGANIZER_ENDPOINT=
DATABASE_PATH=data/cqa.sqlite3
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AI_CONCURRENCY=1
AI_TIMEOUT_SECONDS=120
GEMINI_TIMEOUT_SECONDS=30
AI_EVALUATION_TIMEOUT_SECONDS=100
AI_MAX_ATTEMPTS=3
AI_TRANSIENT_ATTEMPTS_PER_CONNECTION=2
AI_QUOTA_EXHAUSTION_COOLDOWN_SECONDS=3600
AI_TRANSIENT_COOLDOWN_SECONDS=5
# Application pacing, not a claim about your project's actual quota.
AI_MIN_REQUEST_INTERVAL_SECONDS=15
AI_RATE_LIMIT_COOLDOWN_SECONDS=60
AI_RETRY_BASE_SECONDS=5
AI_RETRY_MAX_SECONDS=10
GEMINI_TEMPERATURE=1.0
# Current N/A regression profile; higher token use/latency than minimal. See docs/qa/na-live-recheck-20261108.md.
GEMINI_THINKING_LEVEL=high
GEMINI_THINKING_BUDGET=
GEMINI_MAX_OUTPUT_TOKENS=8192
AI_USAGE_LOG_PATH=data/ai_usage.jsonl
# Optional price snapshot. Blank means unknown; these do not select a billing tier.
AI_INPUT_USD_PER_MILLION=
AI_CACHED_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
AI_PRICE_LABEL=
