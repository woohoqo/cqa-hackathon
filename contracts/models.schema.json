        "raw_response": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Response"
        },
        "original_score": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScoreSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
