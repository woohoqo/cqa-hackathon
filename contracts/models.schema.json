    "Criterion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "section_id": {
          "default": "general",
          "maxLength": 200,
          "minLength": 1,
          "title": "Section Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "weight": {
          "minimum": 0,
          "title": "Weight",
          "type": "number"
        },
        "answer_type": {
          "$ref": "#/$defs/AnswerType"
        },
        "scale": {
          "items": {
            "$ref": "#/$defs/ScaleStep"
          },
          "title": "Scale",
          "type": "array"
        },
        "allow_na": {
          "default": false,
          "title": "Allow Na",
          "type": "boolean"
        },
        "na_condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
