# Copy to .env in the cqa-hackathon root (next to pyproject.toml).
# Fill only GEMINI_API_KEY. Never commit the filled .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_PROVIDER=gemini

# Free-tier profile: one evaluation at a time; one successful model call.
AI_CONCURRENCY=1
AI_MAX_ATTEMPTS=2
AI_MIN_REQUEST_INTERVAL_SECONDS=15
AI_RATE_LIMIT_COOLDOWN_SECONDS=60
AI_RETRY_BASE_SECONDS=5
AI_RETRY_MAX_SECONDS=10

# 15 seconds is our conservative pacing, NOT an official Gemini quota.
# Check your project's actual RPM / input TPM / RPD in AI Studio:
# https://aistudio.google.com/usage?timeRange=last-28-days&tab=rate-limit
# Limits are shared by the project, including other apps/API keys.
# Run one backend worker. This local limiter does not coordinate processes.

GEMINI_TEMPERATURE=1.0
GEMINI_THINKING_LEVEL=minimal
GEMINI_THINKING_BUDGET=
# Keep enough room for every criterion + evidence; no transcript truncation.
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_TIMEOUT_SECONDS=30
AI_EVALUATION_TIMEOUT_SECONDS=100
AI_TIMEOUT_SECONDS=120

DATABASE_PATH=data/cqa.sqlite3
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEV_API_URL=
AI_USAGE_LOG_PATH=data/ai_usage.jsonl

# Free-tier rates only; these variables do not switch Google billing tiers.
# Actual token counts come from Gemini usageMetadata; unknown stays null.
AI_INPUT_USD_PER_MILLION=0
AI_CACHED_INPUT_USD_PER_MILLION=0
AI_OUTPUT_USD_PER_MILLION=0
AI_PRICE_LABEL=Gemini 3.5 Flash-Lite Free Tier 2026-11-07
