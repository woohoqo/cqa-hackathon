          "maxLength": 200,
          "minLength": 1,
          "title": "Criterion Id",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "author": {
          "minLength": 1,
          "title": "Author",
          "type": "string"
        },
        "proposed_value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "number"
            },
            {
              "const": "N/A",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposed Value"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "evaluation_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Evaluation Id",
          "type": "string"
