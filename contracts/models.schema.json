        "version"
      ],
      "title": "ChecklistVersion",
      "type": "object"
    },
    "Conversation": {
      "additionalProperties": false,
      "properties": {
        "external_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Id"
        },
        "source": {
          "default": "manual",
          "maxLength": 200,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/Message"
          },
          "minItems": 1,
          "title": "Messages",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "messages",
        "id"
      ],
      "title": "Conversation",
      "type": "object"
    },
    "ConversationInput": {
      "additionalProperties": false,
      "properties": {
        "external_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Id"
        },
        "source": {
          "default": "manual",
