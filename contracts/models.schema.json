            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Final Criteria"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorDetail"
            },
            {
              "type": "null"
            }
          ],
          "default": null
