      "title": "Appeal",
      "type": "object"
    },
    "AppealCreate": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Criterion Id",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "author": {
          "minLength": 1,
          "title": "Author",
          "type": "string"
        },
        "proposed_value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "number"
            },
